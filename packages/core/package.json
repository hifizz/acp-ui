{
  "name": "@acp-render/core",
  "version": "0.1.0",
  "description": "Framework-agnostic state, presentation rows and diff aggregation for Agent Client Protocol (ACP) session UIs.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hifizz/acp-render.git",
    "directory": "packages/core"
  },
  "keywords": [
    "acp",
    "agent-client-protocol",
    "agent",
    "chat",
    "ui"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "diff": "9.0.0"
  },
  "devDependencies": {
    "tsup": "8.5.1"
  }
}
